# Lambda の環境変数。AWS 上では SECRET_ID から認証情報を読む。
# ローカル実行では SECRET_ID を空にし、下の認証情報を設定する。

SECRET_ID=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=ap-northeast-1
NOTES_BUCKET_NAME=
OBSIDIAN_VAULT_NAME=ks-vault
OBSIDIAN_DAILY_FOLDER=00_daily_notes

# ローカル実行のみ。JSON 文字列か、サービスアカウント JSON ファイルのパス。
GOOGLE_SERVICE_ACCOUNT_JSON=
ANTHROPIC_API_KEY=
# claude か bedrock。ここを変えると文字起こし先と週次要約先が切り替わる。
TRANSCRIPTION_PROVIDER=claude
CLAUDE_MODEL_ID=claude-sonnet-5-5

# 週次要約。ローカル実行のみ。AWS 上ではシークレットから読む。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
OBSIDIAN_SUMMARY_FOLDER=daily_note_summaries

# Kindle 要約。ローカル実行のみ。AWS 上では CDK の環境変数を参照。
OBSIDIAN_KINDLE_FOLDER=kindle
KINDLE_DRIVE_PARENT_FOLDER_NAME=kindle
KINDLE_BOOK_FOLDER_PREFIX=kindle_
KINDLE_PROCESSED_FOLDER_NAME=processed
# KINDLE_CLAUDE_MODEL_ID=claude-sonnet-5-5

# CSV 取り込み。ローカル実行のみ。AWS 上では CDK の環境変数を参照。
CSV_INBOX_FOLDER_NAME=csv_inbox
CSV_PROCESSED_FOLDER_NAME=csv_processed
CSV_SPREADSHEET_ID=1nKB9S7EHVue05Kcwb3F_VGVOHHuYBJ1F84-pUwQCHNU

# Secrets Manager のシークレット 1 件の中身:
# 既に作成済みの notes-pipeline/credentials には lineChannelAccessToken と lineUserId を手で追加する。
# {
#   "googleServiceAccount": { "client_email": "...", "private_key": "..." },
#   "anthropicApiKey": "...",
#   "lineChannelAccessToken": "...",
#   "lineUserId": "..."
# }
