# Lambda の環境変数。AWS 上では SECRET_ID から認証情報を読む。
# ローカル実行では SECRET_ID を空にし、下の認証情報を設定する。

SECRET_ID=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=ap-northeast-1
CRAFT_FOLDER_NAME=

# ローカル実行のみ。JSON 文字列か、サービスアカウント JSON ファイルのパス。
GOOGLE_SERVICE_ACCOUNT_JSON=
CRAFT_API_BASE_URL=
CRAFT_API_KEY=
ANTHROPIC_API_KEY=
# claude か bedrock。ここを変えると文字起こし先が切り替わる。
TRANSCRIPTION_PROVIDER=claude
CLAUDE_MODEL_ID=claude-haiku-5-5

# Secrets Manager のシークレット 1 件の中身:
# {
#   "googleServiceAccount": { "client_email": "...", "private_key": "..." },
#   "craftApiBaseUrl": "https://connect.craft.do/links/<id>/api/v1",
#   "craftApiKey": "...",
#   "anthropicApiKey": "..."
# }
